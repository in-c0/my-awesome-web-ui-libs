{
  "name": "knurl-ui",
  "version": "0.2.0",
  "description": "UI controls machined as isometric instruments: a switch is a toggle on a panel, a slider is a fader, a progress bar is a dial gauge. 18 controls, line or solid finish, React or plain DOM, no dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite site",
    "site": "node registry/build.mjs && vite build site && vite build site --mode single",
    "registry": "node registry/build.mjs",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "switch",
    "slider",
    "knob",
    "isometric",
    "svg",
    "shadcn",
    "registry"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/in-c0/knurl.git"
  },
  "homepage": "https://in-c0.github.io/knurl",
  "bugs": {
    "url": "https://github.com/in-c0/knurl/issues"
  },
  "packageManager": "pnpm@10.28.0"
}
