{
  "name": "@in-c0/paper-ui",
  "version": "0.1.0-alpha.1",
  "description": "Material-aware, accessible React UI primitives with paper shaders, graphite handwriting, and calm interaction",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "components",
    "paper",
    "graphite",
    "handwriting",
    "shader",
    "material",
    "ui"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/paper.css.d.ts",
      "default": "./dist/paper.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/paper.css dist/paper.css && cp src/paper.css.d.ts dist/paper.css.d.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@paper-design/shaders-react": "0.0.81",
    "tegaki": "1.0.3"
  },
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^6.0.3",
    "@types/bun": "^1.4.2"
  },
  "homepage": "https://github.com/in-c0/paper-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/in-c0/paper-ui.git",
    "directory": "packages/paper-ui"
  },
  "bugs": {
    "url": "https://github.com/in-c0/paper-ui/issues"
  }
}
