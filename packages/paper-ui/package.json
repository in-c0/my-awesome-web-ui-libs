{
  "name": "paper-ui-workspace",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter @in-c0/paper-ui-studio dev",
    "build": "bun --filter @in-c0/paper-ui build && bun --filter @in-c0/paper-ui-studio build",
    "typecheck": "bun --filter @in-c0/paper-ui build && bun --filter @in-c0/paper-ui-studio typecheck",
    "test": "bun --filter @in-c0/paper-ui test && bun --filter @in-c0/paper-ui-studio test",
    "test:browser": "bunx playwright test --config apps/studio/playwright.config.ts",
    "check": "bun run build && bun run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@biomejs/biome": "^2.5.14"
  },
  "webUiSite": {
    "title": "Paper UI",
    "tagline": "Material-aware, quietly interactive React components: paper shaders and stroke-by-stroke handwriting.",
    "build": "pnpm --filter @in-c0/paper-ui build && pnpm --filter @in-c0/paper-ui-studio exec vite build --base ./",
    "dir": "apps/studio/dist",
    "preview": "docs/preview.png",
    "npm": "@in-c0/paper-ui",
    "npmPackageJson": "packages/paper-ui/package.json"
  }
}
