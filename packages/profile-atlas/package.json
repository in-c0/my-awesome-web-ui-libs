{
  "name": "@in-c0/profile-atlas",
  "version": "0.1.0",
  "description": "Two framework-free Web Components for a GitHub profile: a project gallery with a searchable index, and a four-lane public activity timeline. No build step, no dependencies, no token.",
  "type": "module",
  "main": "./src/profile-atlas.js",
  "module": "./src/profile-atlas.js",
  "exports": {
    ".": "./src/profile-atlas.js",
    "./profile-atlas.js": "./src/profile-atlas.js",
    "./timeline-math.js": "./src/timeline-math.js",
    "./style.css": "./src/profile-atlas.css",
    "./profile-atlas.css": "./src/profile-atlas.css",
    "./github-activity-timeline.css": "./src/github-activity-timeline.css",
    "./mellow-overrides.css": "./src/mellow-overrides.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/profile-atlas.js",
    "src/timeline-math.js",
    "src/profile-atlas.css",
    "src/github-activity-timeline.css",
    "src/mellow-overrides.css",
    "CHANGELOG.md"
  ],
  "keywords": [
    "web-components",
    "custom-elements",
    "github",
    "profile",
    "gallery",
    "timeline",
    "portfolio",
    "framework-free",
    "buildless"
  ],
  "homepage": "https://in-c0.github.io/my-awesome-web-ui-libs/profile-atlas/",
  "bugs": {
    "url": "https://github.com/in-c0/my-awesome-web-ui-libs/issues"
  },
  "license": "MIT",
  "sideEffects": [
    "./src/profile-atlas.js",
    "*.css"
  ],
  "scripts": {
    "test": "rm -rf dist && mkdir -p dist && cp -r src dist/src && node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/in-c0/my-awesome-web-ui-libs.git",
    "directory": "packages/profile-atlas"
  },
  "publishConfig": {
    "access": "public"
  },
  "webUiSite": {
    "title": "Profile Atlas",
    "tagline": "Framework-free Web Components for a GitHub profile: project gallery, index and activity timeline.",
    "copy": [
      "docs",
      "demo",
      "src",
      "data",
      "assets"
    ],
    "index": "docs/index.html",
    "preview": "assets/docs-preview.png"
  }
}
